# ---------------------------------------------------------------------------
# Azure OpenAI (Microsoft Foundry) resource
# ---------------------------------------------------------------------------
# Resource endpoint, no trailing path. Azure portal -> your resource ->
# "Keys and Endpoint". SIP is only supported in swedencentral and eastus2.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com

# Key 1 or Key 2 from the same blade.
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>

# The name of your *deployment*, not the underlying model name.
AZURE_OPENAI_DEPLOYMENT=gpt-realtime

# Signing secret printed by `python scripts/webhook_endpoints.py create`.
# Shown only once.
AZURE_OPENAI_WEBHOOK_SECRET=whsec_<your-signing-secret>

# Optional. Deployment name of a transcription model (for example a
# gpt-4o-transcribe deployment). Azure requires a *deployment* name here, not a
# model name. Leave empty and the live transcript shows the assistant side only;
# set it to also capture what the caller says.
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Webhook registration
# ---------------------------------------------------------------------------
# Publicly reachable HTTPS URL of this server's webhook route.
# Local dev tunnel:  https://<tunnel-id>-8000.<cluster>.devtunnels.ms/webhook
# Azure App Service: https://<app-name>.azurewebsites.net/webhook
WEBHOOK_PUBLIC_URL=https://<your-public-host>/webhook
WEBHOOK_NAME=sip-realtime-listener

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000

# Optional. SQLite file holding the demo customers, call log and transcripts.
# Defaults to ./data/bank.db
DATABASE_PATH=

# Optional. INFO or DEBUG.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# Optional. Your own mobile number in E.164. At seed time this replaces the
# first demo customer's number, so calling from your handset is recognised.
# You can also just edit the record in the web UI.
DEMO_CUSTOMER_MSISDN=

# ---------------------------------------------------------------------------
# Agent defaults (all optional; the UI overrides these and persists to the DB)
# ---------------------------------------------------------------------------
# AGENT_INSTRUCTIONS=You are the virtual assistant for a retail bank.
# WELCOME_GREETING=Thank you for calling, how can I help you?
# AGENT_VOICE=alloy
