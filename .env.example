# ---------------------------------------------------------------------------
# Azure OpenAI (Microsoft Foundry) resource
# ---------------------------------------------------------------------------
# Resource endpoint, no trailing path. Azure portal -> your resource ->
# "Keys and Endpoint". SIP is only supported in swedencentral and eastus2.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com

# Key 1 or Key 2 from the same blade.
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>

# The name of your *deployment*, not the underlying model name.
AZURE_OPENAI_DEPLOYMENT=gpt-realtime

# Signing secret printed by `python scripts/webhook_endpoints.py create`.
# Shown only once.
AZURE_OPENAI_WEBHOOK_SECRET=whsec_<your-signing-secret>

# Optional. Model used to transcribe the caller, seeding the value on a fresh
# database; the console owns it afterwards. Defaults to "whisper", which needs
# no separate deployment. Leave empty to disable caller transcription.
TRANSCRIPTION_MODEL=

# ---------------------------------------------------------------------------
# Webhook registration
# ---------------------------------------------------------------------------
# Publicly reachable HTTPS URL of this server's webhook route.
# Local dev tunnel:  https://<tunnel-id>-8000.<cluster>.devtunnels.ms/webhook
# Azure App Service: https://<app-name>.azurewebsites.net/webhook
WEBHOOK_PUBLIC_URL=https://<your-public-host>/webhook
WEBHOOK_NAME=sip-realtime-listener

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000

# Optional. SQLite file holding the demo customers, call log and transcripts.
# Defaults to ./data/bank.db
DATABASE_PATH=

# Optional. INFO or DEBUG.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# Optional. Your own mobile number in E.164. At seed time this replaces the
# first demo customer's number, so calling from your handset is recognised.
# You can also just edit the record in the web UI.
DEMO_CUSTOMER_MSISDN=

# ---------------------------------------------------------------------------
# Agent defaults (optional; the console overrides these and persists to the DB)
# ---------------------------------------------------------------------------
# Bank name, voices, playback speed, turn detection and the Arabic style
# prompts are all managed in the console under Agent settings, not here.
# How the agent opens the call is derived from the customer profile and the
# active Arabic style, so there is no separate greeting string.
# AGENT_INSTRUCTIONS=You are the virtual assistant for a retail bank.

# ---------------------------------------------------------------------------
# Knowledge base (optional; Azure AI Search)
# ---------------------------------------------------------------------------
# An Azure AI Search knowledge base is itself an MCP server, and the realtime
# service calls it directly. Set all three and the agent can look things up
# mid-call; leave any of them empty and the feature stays dormant.
# Which questions it is used for is set in the console under Agent settings.

# Search service endpoint, no trailing slash.
AZURE_SEARCH_ENDPOINT=

# Name of the knowledge base (not the index, and not a knowledge source).
AZURE_SEARCH_KNOWLEDGE_BASE=

# Admin or query key for the search service. Required: without it the
# knowledge base is not attached to the call.
AZURE_SEARCH_API_KEY=

# Optional. Defaults to 2026-08-01-preview, which returns synthesized answers.
# Use 2026-04-01 for extractive grounding data instead.
AZURE_SEARCH_API_VERSION=

# Optional escape hatches. Override the whole MCP URL, or the label the agent
# sees for the server. Both are derived from the values above by default.
AZURE_SEARCH_MCP_URL=
AZURE_SEARCH_MCP_SERVER_LABEL=
